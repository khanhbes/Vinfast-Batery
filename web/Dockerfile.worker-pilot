FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt && pip check
# Allowlist only: no control provider, reconciliation or operation repository.
COPY shelly/__init__.py shelly/profile_vault.py shelly/worker_pilot.py ./shelly/
RUN useradd --system --uid 10001 --no-create-home worker
USER 10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD ["python", "-m", "shelly.worker_pilot", "--healthcheck"]
CMD ["python", "-m", "shelly.worker_pilot"]
