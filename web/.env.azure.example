# Azure staging only. Copy privately to .env.azure; do not commit values.
APP_ENV=production
AZURE_STAGING_HARDWARE_DISABLED=1
FIREBASE_CREDENTIALS_JSON=<base64-service-account-json>
SHELLY_PROFILE_MASTER_KEY=<preserve-existing-vault-master-key>
AI_SERVER_INTERNAL_TOKEN=<independent-staging-token-shared-by-api-and-ai>
DEV_ADMIN_KEY=<independent-staging-admin-key>
ADMIN_EMAILS=<explicit-admin-email>
AI_SERVER_URL=https://<internal-ai-fqdn>
AI_SERVER_TIMEOUT=90
AI_SERVER_MODELS_DIR=/app/data/models
EV_SOC_MODEL_PATH=/app/data/models/ev_soc_pipeline.pkl
APK_DIR=/app/data/apk
APP_CONFIG_FILE=/app/data/apk/app_config.json
DASHBOARD_URL=https://<admin>.azurestaticapps.net
CORS_ORIGINS=https://<admin>.azurestaticapps.net
GEMINI_API_KEY=<optional-server-only-key>
GEMINI_CHAT_MODEL=<explicit-supported-model>
# Never prefix server credentials with VITE_.
