# Copy this file to .env.laptop. Never commit .env.laptop or share its values.
# Generate random Base64 values in PowerShell:
#   $b=New-Object byte[] 32; $r=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)

# Required: protects encrypted Shelly profiles saved by this laptop server.
SHELLY_PROFILE_MASTER_KEY=

# Required in production: minified JSON of a Firebase service account.
# Keep on one line and do not quote it with smart quotes.
FIREBASE_CREDENTIALS_JSON=

APP_ENV=production
CORS_ORIGINS=https://your-machine.your-tailnet.ts.net,http://127.0.0.1:8080

# Generate unique values; API and AI containers must use the same internal token.
AI_SERVER_INTERNAL_TOKEN=
DEV_ADMIN_KEY=
ADMIN_EMAILS=khanhnhim21102004@gmail.com

# The current safety limit in the application is 10 hours.
SMART_CHARGE_MAX_MINUTES=600

# Firebase Web SDK used by the React dashboard image.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
