# ══════════════════════════════════════════════════════════════
# VinFast Battery — Docker Environment Variables
# Copy file này thành .env rồi điền giá trị thật
# ══════════════════════════════════════════════════════════════

APP_ENV=production
CORS_ORIGINS=https://your-domain.example

# Hardware supervision: API and worker must use the SAME scope, unique per
# environment. Leaving this empty fails ON/safety authorization closed.
# Configure only after worker fault/smoke gates and separate deploy approval.
SMART_CHARGE_WORKER_SCOPE=
SMART_CHARGE_WORKER_POLL_SECONDS=60
# Private readiness probe; do not expose this port publicly.
SMART_CHARGE_WORKER_HEALTH_PORT=8090

# ── Bảo mật nội bộ ────────────────────────────────────────────
# Token xác thực giữa Flask API ↔ AI Server
AI_SERVER_INTERNAL_TOKEN=

# Optional BatteryBot Gemini provider; leave both empty for offline guidance.
# Choose a currently supported model in Google AI Studio. Do not commit real keys.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=

# Key bypass admin cho dev/internal tool (X-Admin-Key header)
DEV_ADMIN_KEY=

# ── Quyền Admin ───────────────────────────────────────────────
# Danh sách email admin, phân cách bằng dấu phẩy
# Dùng * để tất cả tài khoản đều là admin (chỉ cho dev)
ADMIN_EMAILS=

# ── Firebase Admin SDK (backend) ──────────────────────────────
# Cách tạo: base64 -w 0 vinfast-...-firebase-adminsdk.json
# Trên Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
FIREBASE_CREDENTIALS_JSON=

# ── Firebase Web Config (React dashboard) ─────────────────────
# Lấy từ Firebase Console → Project Settings → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
