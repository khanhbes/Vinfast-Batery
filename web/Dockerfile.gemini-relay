# Gemini relay (Task 124): tiny, no Flask/AI deps. Build context: web/gemini_relay
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir requests==2.32.5 && useradd --system --uid 10001 --no-create-home relay
COPY relay.py ./
USER 10001
EXPOSE 8080
CMD ["python", "relay.py"]
