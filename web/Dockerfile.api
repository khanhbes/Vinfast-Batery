# ── Flask Unified API (port 5000) ─────────────────────────────
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY server.py telemetry_schema.py .
COPY ai_server/ ./ai_server/
COPY shelly/ ./shelly/

# Fail the build if OneDrive/Docker BuildKit provides an offline or empty
# placeholder instead of the actual API source.  Without this guard Python
# exits cleanly and Docker keeps restarting an apparently healthy image.
RUN test -s /app/server.py

RUN mkdir -p /app/models

EXPOSE 5000

ENV FLASK_ENV=production \
    FLASK_USE_RELOADER=0 \
    PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

CMD ["gunicorn", "--workers=1", "--threads=4", "--bind=0.0.0.0:5000", "server:app"]
