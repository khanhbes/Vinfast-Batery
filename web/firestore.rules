rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(ownerUid) {
      return isAuth() && request.auth.uid == ownerUid;
    }
    function activeVehicleLimit(uid) {
      let configured = get(/databases/$(database)/documents/users/$(uid)).data.maxActiveVehicles;
      return configured is int && configured >= 1 && configured <= 10 ? configured : 2;
    }
    function notDeleted() {
      return resource.data.isDeleted != true &&
        resource.data.isArchived != true &&
        resource.data.archivedAt == null;
    }
    // True if the authenticated user owns the Vehicles/{vehicleId} document.
    // Used as a legacy fallback for child docs that may not yet carry ownerUid.
    function ownsVehicleId(vehicleId) {
      return isAuth()
        && vehicleId is string
        && exists(/databases/$(database)/documents/Vehicles/$(vehicleId))
        && get(/databases/$(database)/documents/Vehicles/$(vehicleId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/Vehicles/$(vehicleId)).data.isDeleted != true
        && get(/databases/$(database)/documents/Vehicles/$(vehicleId)).data.isArchived != true
        && get(/databases/$(database)/documents/Vehicles/$(vehicleId)).data.archivedAt == null;
    }
    // Read access if the doc has ownerUid matching the user, OR (legacy)
    // ownerUid is missing but vehicleId resolves to a Vehicle the user owns.
    function canReadOwned() {
      return isAuth() && (
        (resource.data.ownerUid == request.auth.uid) ||
        (!('ownerUid' in resource.data) && ownsVehicleId(resource.data.vehicleId))
      );
    }
    function canCreateOwned() {
      return isAuth() && request.resource.data.ownerUid == request.auth.uid;
    }
    function containsNoChargerSecrets() {
      return !('cloudAuthKey' in request.resource.data) &&
        !('cloud_auth_key' in request.resource.data) &&
        !('localPassword' in request.resource.data) &&
        !('local_password' in request.resource.data) &&
        !('authorizationKey' in request.resource.data);
    }

    // ── Users (profile sync từ app) ──
    match /users/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid &&
        (!('vehicles' in request.resource.data) ||
         request.resource.data.vehicles.size() <= activeVehicleLimit(uid));
      allow create: if isAuth() && request.auth.uid == uid;
      allow delete: if false;

      match /vehicleChargerBindings/{vehicleId} {
        allow read: if isAuth() && request.auth.uid == uid && ownsVehicleId(vehicleId);
        allow write: if isAuth() && request.auth.uid == uid &&
          ownsVehicleId(vehicleId) && containsNoChargerSecrets();
      }
      match /smartChargePreferences/{preferenceId} {
        allow read: if isAuth() && request.auth.uid == uid;
        allow create, update: if isAuth() && request.auth.uid == uid &&
          request.resource.data.ownerUid == uid &&
          containsNoChargerSecrets() &&
          (!('tariffVndPerKwh' in request.resource.data) ||
           request.resource.data.tariffVndPerKwh == null ||
           (request.resource.data.tariffVndPerKwh is number &&
            request.resource.data.tariffVndPerKwh > 0 &&
            request.resource.data.tariffVndPerKwh <= 100000));
        allow delete: if isAuth() && request.auth.uid == uid;
      }
      match /shellyDevices/{deviceId} {
        allow read: if isAuth() && request.auth.uid == uid;
        // Device discovery, verification and revocation are authoritative
        // backend operations. A client must not be able to self-assert a
        // verified Shelly/capability and bypass the API safety gate.
        allow write: if false;
      }
      match /smartChargingSessions/{sessionId} {
        allow read: if isAuth() && request.auth.uid == uid;
        // Runtime sessions are created/reconciled by the authenticated API
        // (Admin SDK). The app reads this legacy collection only during the
        // migration window and cannot forge an active session here.
        allow create, update: if false;
      }
      match /chargingTrainingSamples/{sampleId} {
        // Training samples are written by the authenticated API/backend only;
        // the app submits them through Smart Charge endpoints.
        allow read: if isAuth() && request.auth.uid == uid;
        allow write: if false;
      }
      match /personalProfileVersions/{vehicleId} {
        allow read: if isAuth() && request.auth.uid == uid;
        allow write: if false;
      }
      match /personalProfileVersionHistory/{versionId} {
        allow read: if isAuth() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── Vehicles ──
    match /Vehicles/{vehicleId} {
      allow read: if isAuth() && isOwner(resource.data.ownerUid);
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuth() && isOwner(resource.data.ownerUid) &&
        request.resource.data.ownerUid == request.auth.uid;
      // Vehicles are archived via isDeleted/archivedAt; physical deletion is
      // prohibited so histories and AI profiles remain recoverable.
      allow delete: if false;
    }

    // ── ChargeLogs ──
    match /ChargeLogs/{logId} {
      allow read: if canReadOwned() && notDeleted();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid) &&
        request.resource.data.ownerUid == request.auth.uid;
      // Privacy erase is an explicit, owner-confirmed terminal-session action
      // in the app. It must be possible in Direct mode without granting a
      // user the ability to erase an active charging record.
      allow delete: if isAuth() && isOwner(resource.data.ownerUid) &&
        (!('sessionState' in resource.data) ||
         (resource.data.sessionState != 'arming' &&
          resource.data.sessionState != 'active'));

      match /smartChargeTelemetry/{chunkId} {
        function parentLog() {
          return get(/databases/$(database)/documents/ChargeLogs/$(logId));
        }

        allow read: if isAuth() &&
          parentLog().data.ownerUid == request.auth.uid;
        allow create, update: if isAuth() &&
          parentLog().data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.sessionId == logId;
        allow delete: if isAuth() &&
          parentLog().data.ownerUid == request.auth.uid &&
          (!('sessionState' in parentLog().data) ||
           (parentLog().data.sessionState != 'arming' &&
            parentLog().data.sessionState != 'active'));
      }

      // Safety events are append-only client evidence tied to the canonical
      // parent session. The backend may enrich them through the Admin SDK.
      match /safetyEvents/{eventId} {
        function parentLog() {
          return get(/databases/$(database)/documents/ChargeLogs/$(logId));
        }

        allow read: if isAuth() &&
          parentLog().data.ownerUid == request.auth.uid;
        allow create: if isAuth() &&
          parentLog().data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.sessionId == logId;
        allow update, delete: if false;
      }
    }

    // ── ChargeSamples (AI training data - implicit collection) ──
    // App writes training samples; backend aggregates for fine-tuning
    match /ChargeSamples/{sampleId} {
      allow read: if canReadOwned() && notDeleted();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid) &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // ── TripLogs ──
    match /TripLogs/{tripId} {
      allow read: if canReadOwned() && notDeleted();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid);
      allow delete: if false;
    }

    // ── MaintenanceTasks ──
    // IMPORTANT: Client queries MUST include .where('isDeleted', isEqualTo: false)
    // alongside .where('ownerUid', ...) so Firestore's query evaluator can confirm
    // that canReadOwned() && notDeleted() is satisfied for every returned document.
    // Without the isDeleted constraint the evaluator rejects the query with
    // PERMISSION_DENIED even when all documents would individually pass.
    match /MaintenanceTasks/{taskId} {
      allow read: if canReadOwned() && notDeleted();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid);
      // Allow owner to hard-delete their own tasks (used by deleteMaintenanceTask).
      allow delete: if isAuth() && isOwner(resource.data.ownerUid);
    }

    // ── TelemetryPoints ──
    match /TelemetryPoints/{pointId} {
      allow read: if canReadOwned() && notDeleted();
      allow create: if canCreateOwned();
      allow update: if false;
      allow delete: if false;
    }

    // ── battery_states (real-time SOC snapshots written by app) ──
    match /battery_states/{stateId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid);
      allow delete: if false;
    }

    // ── trip_predictions (AI prediction history) ──
    match /trip_predictions/{predictionId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid);
      allow delete: if isAuth() && isOwner(resource.data.ownerUid);
    }

    // ── soc_predictions (AI SOC prediction history) ──
    match /soc_predictions/{predictionId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if isAuth() && isOwner(resource.data.ownerUid);
      allow delete: if false;
    }

    // ── VinFastModelSpecs (public read, no client write) ──
    match /VinFastModelSpecs/{modelId} {
      allow read: if true;
      allow write: if false; // Managed via backend/admin
    }

    // ── AiVehicleInsights (app reads own data, backend writes via Admin SDK) ──
    match /AiVehicleInsights/{vehicleId} {
      allow read: if isAuth() && isOwner(resource.data.ownerUid);
      allow write: if false; // Managed via backend Admin SDK only
    }

    // ── AiVehicleProfiles (backend only via Admin SDK) ──
    match /AiVehicleProfiles/{vehicleId} {
      allow read, write: if false;
    }

    // ── AuditLogs (backend only) ──
    match /AuditLogs/{logId} {
      allow read, write: if false;
    }

    // ── AiModelDeployments (PLAN1: AI deployment lifecycle) ──
    // Backend/admin only write; authenticated users can read
    match /AiModelDeployments/{typeKey} {
      allow read: if isAuth();
      allow write: if false; // Managed via backend Admin SDK only
    }

    // ── UserNotifications ──
    match /UserNotifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
