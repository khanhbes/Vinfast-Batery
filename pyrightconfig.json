{
  "include": ["web", "tools"],
  "exclude": [
    "**/node_modules", "**/__pycache__", "**/.venv", "**/.pytest*",
    "web/dashboard", "web/data", "web/models", "web/qa-evidence"
  ],
  "typeCheckingMode": "basic",
  "executionEnvironments": [
    {"root": "web/tests", "extraPaths": ["web"]},
    {"root": "web", "extraPaths": ["web"]},
    {"root": "tools", "extraPaths": ["web"]}
  ]
}
